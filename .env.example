# ---- core ----
NODE_ENV=production
PORT=8080
JWT_SECRET=replace-with-64-random-bytes        # required in production: openssl rand -hex 64
DB_FILE=/data/mapos.db                         # SQLite (MVP). PostGIS: DATABASE_URL (phase 2)
CORS_ORIGINS=https://mapos.example.in           # comma-separated allowed origins for the API
TRUST_PROXY=1                                   # set when behind a load balancer (correct client IPs for rate limiting)
RATE_LIMIT_PER_MIN=240
LOG_REQUESTS=1
DEMO_PASSWORD=change-me                         # password for seeded demo accounts; remove seed in real launch
DEMO_TIME_SCALE=20                              # tracking simulation speed (1 = real time)

# ---- open data services (defaults are public demo servers: dev only) ----
OSRM_URL=http://osrm:5000
NOMINATIM_URL=                                  # self-hosted Nominatim/Photon recommended
OVERPASS_URL=
TILE_UPSTREAM=https://tiles.openfreemap.org     # or your PMTiles/CDN origin
MAP_STYLE=liberty
HTTP_USER_AGENT=BharatMap/0.1 (ops@example.in) # required by OSM usage policies
OFFLINE=0                                       # 1 = never call external services

# ---- optional AI layer (OpenAI-compatible) ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- ONDC (prototype adapter) ----
ONDC_BPP_ID=
ONDC_BPP_URI=

# ---- v0.4 map services (/api/v1); unset = public OSM instances (dev only, 1 req/s) ----
# VALHALLA_URL=http://valhalla:8002
# OSRM_URL_CAR=http://osrm:5000
# OSRM_URL_BIKE=
# OSRM_URL_FOOT=
# PHOTON_URL=http://photon:2322
# NOMINATIM_URL=http://nominatim:8080
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OCM_API_KEY=            # Open Charge Map (free key); stays on the server
# HTTP_USER_AGENT=BharatMap/0.4 (+https://your.site; you@example.com)
# CLIENT_SERVICES=server  # server-hosted web app uses /api/v1
# REGIONS_DIR=data/regions
# REGIONS_BASE=           # CDN base for offline regions, if not served by this server
# TRANSIT_FEEDS_DIR=data/gtfs
# V1_RATE_BURST=60
# V1_RATE_PER_SEC=2

# ---- v0.7 payments (each gateway enabled only by its own keys; none = "Payments not configured") ----
# See docs/CONFIGURATION.md. Cashfree / PhonePe / Paytm are prototype adapters (never run against a live sandbox).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox            # production = live API
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# PHONEPE_ENV=sandbox             # production = live API
# PHONEPE_WEBHOOK_USER=
# PHONEPE_WEBHOOK_PASSWORD=
# PAYTM_MID=
# PAYTM_MERCHANT_KEY=
# PAYTM_WEBSITE=WEBSTAGING
# PAYTM_ENV=staging               # production = live API
# PUBLIC_BASE_URL=https://mapos.example.in   # used for gateway return URLs (#/pay/<orderId>)

# ---- v0.7 live traffic (unset = "Live traffic unavailable") ----
# TRAFFIC_PROVIDER=tomtom         # tomtom | here
# TOMTOM_API_KEY=
# HERE_API_KEY=

# ---- v0.7 rides / ONDC prototype / feeds ----
# UBER_CLIENT_ID=                 # public client id for the Uber universal link
# OLA_XAPP_TOKEN=                 # Ola affiliate token (upgrades Ola to a deep link)
# ONDC_PROTOTYPE=0                # 1 = Beckn-shaped buyer flow against Bharat's demo catalogue (not the ONDC network)
# ONDC_BAP_ID=bharatmap.prototype.bap
# SHOWTIMES_FEED_URL=             # placeholder; no showtimes adapter is connected
